# Application Configuration
PROJECT_NAME="Dayflow HRMS API"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-change-this-in-production-environment"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Settings (Uses SQLite by default if PostgreSQL is not available)
DATABASE_URL="sqlite+aiosqlite:///./dayflow.db"
# For PostgreSQL: DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dayflow_db"

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
